{
  "name": "vellum-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "cd .. && bun run build && mkdir -p worker/public/dist && cp dist/main.js dist/webmcp.js worker/public/dist/ && cd app && bunx vite build",
    "deploy": "bun ../scripts/deploy.ts",
    "test": "bun test tests/",
    "test:watch": "bun test tests/ --watch",
    "migrate": "wrangler d1 migrations apply vellum",
    "migrate:local": "wrangler d1 migrations apply vellum --local",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  },
  "packageManager": "bun@1.3.14"
}
